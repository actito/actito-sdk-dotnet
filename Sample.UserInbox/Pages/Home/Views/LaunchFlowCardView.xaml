<?xml version="1.0" encoding="utf-8"?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:Sample.UserInbox.Views"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="Sample.UserInbox.Pages.Home.Views.LaunchFlowCardView"
             x:Name="This">

    <ContentView.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentView.Resources>

    <VerticalStackLayout Spacing="8">
        <FlexLayout Direction="Row">
            <Label
                Text="Launch Flow"
                Style="{x:StaticResource CardHeaderLabel}"
                VerticalOptions="End"
                FlexLayout.Grow="1" />

            <Label LineBreakMode="WordWrap" HorizontalTextAlignment="End">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="ⓘ" FontSize="22" FontAttributes="Bold">
                            <Span.GestureRecognizers>
                                <TapGestureRecognizer Tapped="ShowActitoStatusInfo" />
                            </Span.GestureRecognizers>
                        </Span>
                    </FormattedString>
                </Label.FormattedText>
            </Label>
        </FlexLayout>

        <views:CardView>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Text="Unlaunch"
                        Command="{Binding Source={x:Reference This}, Path=UnlaunchCommand}"
                        IsEnabled="{Binding Source={x:Reference This}, Path=IsReady}"
                        CornerRadius="0" />

                <BoxView
                    Grid.Column="1"
                    WidthRequest="1"
                    BackgroundColor="Gray" />

                <Button Grid.Column="2"
                        Text="Launch"
                        Command="{Binding Source={x:Reference This}, Path=LaunchCommand}"
                        IsEnabled="{Binding Source={x:Reference This}, Path=IsReady, Converter={StaticResource InvertedBoolConverter}}"
                        CornerRadius="0" />
            </Grid>
        </views:CardView>
    </VerticalStackLayout>
</ContentView>