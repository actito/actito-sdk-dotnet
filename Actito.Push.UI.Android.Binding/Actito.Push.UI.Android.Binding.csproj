<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>ActitoSdk.Push.UI.Android.Binding</RootNamespace>
        <!--
          Enable trim analyzers for Android class libraries.
          To learn more, see: https://learn.microsoft.com/dotnet/core/deploying/trimming/prepare-libraries-for-trimming
        -->
        <IsTrimmable>true</IsTrimmable>

        <NativeLibraryVersion>5.0.0-beta.2</NativeLibraryVersion>
        <NativeLibraryMavenRepository>Central</NativeLibraryMavenRepository>
    </PropertyGroup>

    <ItemGroup>
        <AndroidMavenLibrary
                Include="com.actito:actito-push-ui"
                Version="$(NativeLibraryVersion)"
                VerifyDependencies="false"
                Bind="true"
                Repository="$(NativeLibraryMavenRepository)"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Actito.Android.Binding\Actito.Android.Binding.csproj"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Xamarin.AndroidX.ConstraintLayout" Version="2.2.1.3"/>
        <PackageReference Include="Xamarin.AndroidX.DataBinding.ViewBinding" Version="8.13.0"/>
        <PackageReference Include="Xamarin.GooglePlayServices.Maps" Version="119.2.0.3"/>
    </ItemGroup>
</Project>
